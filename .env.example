APP_NAME=KITE
# KITE runs on port 5001 so it can run next to FAXORA (port 5000)
FLASK_RUN_PORT=5001
DEPARTMENTS=DPS,SSG,SSI,FSI,CYBER
# development (default), test or production. production refuses SQLite, a missing SECRET_KEY and http:// APP_BASE_URL.
APP_ENV=development
SECRET_KEY=change-me
DATABASE_URL=sqlite:///instance/kite.db
# Production (Azure Database for PostgreSQL): either a full DATABASE_URL, or these parts
# (the password then needs no URL escaping). PGSSLMODE defaults to require.
# PGHOST=kite-prod-pg.postgres.database.azure.com
# PGUSER=kiteadmin
# PGPASSWORD=
# PGDATABASE=kite
APP_BASE_URL=http://localhost:5001
# Hours before a signed-in session ends
SESSION_HOURS=8

# Microsoft Entra ID sign-in (app registration from IT). Redirect URI: <APP_BASE_URL>/auth/callback
SSO_ENABLED=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# AZURE_REDIRECT_URI=https://kite.example.com/auth/callback
# Read the department from the Microsoft profile at sign-in
SSO_READ_DEPARTMENT=true
# Username/password login. Set false at go-live; the break-glass usernames below can still use a password.
LOCAL_LOGIN_ENABLED=true
BREAK_GLASS_USERS=
SMTP_HOST=smtp.example.internal
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=kite-noreply@example.com
SMTP_USE_TLS=false
# First users created by seed.py (8+ characters each; users without a password are skipped)
SEED_ADMIN_PASSWORD=
SEED_LEAD_PASSWORD=
SEED_SME_PASSWORD=
SEED_MEMBER_PASSWORD=
# Optional: email addresses for the seeded users (defaults: admin@, lead@, sme@, member@example.com)
SEED_ADMIN_EMAIL=
SEED_LEAD_EMAIL=
SEED_SME_EMAIL=
SEED_MEMBER_EMAIL=

# Daily reminder emails. Set a long random value to switch on GET /tasks/daily-reminders
# (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"; on Azure the daily-reminders GitHub
# workflow calls it). Leave empty to use only: python -m flask --app app daily-reminders
CRON_SECRET=
